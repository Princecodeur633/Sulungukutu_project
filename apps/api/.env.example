# ──────────────────────────────────────────────────────────────
# sulungukutu API — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ──────────────────────────────────────────────────────────────

# ── Base de données ────────────────────────────────────────────
# Option A : Neon (serverless PostgreSQL - recommandé pour démo)
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Option B : PostgreSQL local
# DATABASE_URL=postgresql://postgres:password@localhost:5432/sulungukutu

DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Auth ───────────────────────────────────────────────────────
# Générer des secrets forts en prod : openssl rand -hex 64
JWT_SECRET=change_me_in_production_use_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change_me_too_different_from_jwt_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Serveur ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Super Admin initial (utilisé par le seed) ─────────────────
SUPER_ADMIN_EMAIL=superadmin@sulungukutu.com
SUPER_ADMIN_PASSWORD=SuperAdmin@2024!

# ── Email (optionnel mais recommandé) ─────────────────────────
# Si non configuré, les emails sont loggués en console (mode dev)
#
# Option Gmail :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password  # Mot de passe d'application Gmail
#
# Option Resend (recommandé pour production) :
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxx
#
# Option Mailtrap (test) :
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_user
# SMTP_PASS=your_mailtrap_pass
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="sulungukutu <noreply@sulungukutu.com>"
FRONTEND_URL=http://localhost:3000

