# ──────────────────────────────────────────────────────────────
# sulungukutu Web — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ──────────────────────────────────────────────────────────────

# ── API Backend ────────────────────────────────────────────────
# URL de l'API GraphQL (sans /graphql à la fin)
# Développement local :
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
# Production (Railway, Render...) :
# NEXT_PUBLIC_API_URL=https://your-api.railway.app/graphql

# ── WebSocket (subscriptions temps réel) ──────────────────────
# Développement local :
NEXT_PUBLIC_WS_URL=ws://localhost:4000/graphql
# Production (wss = WebSocket sécurisé) :
# NEXT_PUBLIC_WS_URL=wss://your-api.railway.app/graphql

# ── Environnement ──────────────────────────────────────────────
NODE_ENV=development

